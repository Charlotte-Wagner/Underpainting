# Underpainting reads its API key through Streamlit's own secrets mechanism,
# not python-dotenv, so this file isn't loaded automatically by the app. It
# exists so a reviewer can see the required config at a glance without
# reading through app.py.
#
# Local dev: copy this variable into .streamlit/secrets.toml (gitignored,
# never committed) as:
#   ANTHROPIC_API_KEY = "sk-ant-..."
#
# Deployed app: paste the same into the Streamlit Cloud app's
# Settings -> Secrets panel. The app reads it as st.secrets["ANTHROPIC_API_KEY"]
# in both places.

ANTHROPIC_API_KEY=sk-ant-your-key-here
